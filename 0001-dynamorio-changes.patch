From d9e27bd60be8a2b00e75661776a01245d023e51b Mon Sep 17 00:00:00 2001
From: Anonymous Author <anonymous@example.com>
Date: Wed, 28 Jan 2026 14:55:54 +0100
Subject: [PATCH] Dynamorio Changes

---
 CMakeLists.txt                               |   2 +
 clients/drcachesim/tools/invariant_checker.h |   1 +
 core/ir/aarch64/codec.c                      |  70 ++++-
 core/ir/aarch64/codec_v82.txt                |  18 ++
 core/ir/aarch64/instr_create_api.h           | 264 ++++++++++++++++++-
 core/ir/aarch64/opnd_defs.txt                |   5 +
 core/unix/signal.c                           |   2 +-
 suite/tests/api/dis-a64.txt                  |   3 +
 suite/tests/api/ir_aarch64_v82.c             |  20 ++
 9 files changed, 381 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 45195167e..a86344809 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -805,6 +805,8 @@ if (UNIX)
   elseif (ARM)
     # i#1551: add necessary flags for ARM build.
     if (X64)
+      set(CMAKE_C_FLAGS "-target arm64v8.5+memtag-linux-gnu ${CMAKE_C_FLAGS}")
+      set(CMAKE_CXX_FLAGS "-target arm64v8.5+memtag-linux-gnu ${CMAKE_CXX_FLAGS}")
     else (X64)
       # On newer gcc versions such as 11.2 we need an explicit +fp to denote our
       # gnueablihf hardware-fp-capabilities target.
diff --git a/clients/drcachesim/tools/invariant_checker.h b/clients/drcachesim/tools/invariant_checker.h
index f1462953a..6610d2841 100644
--- a/clients/drcachesim/tools/invariant_checker.h
+++ b/clients/drcachesim/tools/invariant_checker.h
@@ -41,6 +41,7 @@
 #include <mutex>
 #include <stack>
 #include <unordered_map>
+#include <memory>
 
 class invariant_checker_t : public analysis_tool_t {
 public:
diff --git a/core/ir/aarch64/codec.c b/core/ir/aarch64/codec.c
index b3d813c92..16ddfee7e 100644
--- a/core/ir/aarch64/codec.c
+++ b/core/ir/aarch64/codec.c
@@ -1486,6 +1486,20 @@ encode_opnd_x0(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
     return encode_opnd_wxn(true, false, 0, opnd, enc_out);
 }
 
+/* x0: X register or XSP at bit position 0 */
+
+static inline bool
+decode_opnd_x0sp(uint enc, int opcode, byte *pc, OUT opnd_t *opnd)
+{
+    return decode_opnd_wxn(true, true, 0, enc, opnd);
+}
+
+static inline bool
+encode_opnd_x0sp(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
+{
+    return encode_opnd_wxn(true, true, 0, opnd, enc_out);
+}
+
 /* memx0: memory operand with no offset used as memref for SYS */
 
 static inline bool
@@ -2013,6 +2027,18 @@ encode_opnd_p10_low(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_o
     return encode_opnd_p(10, 7, opnd, enc_out);
 }
 
+static inline bool
+decode_opnd_uimm4(uint enc, int opcode, byte *pc, OUT opnd_t *opnd)
+{
+    return decode_opnd_int(10, 4, false, 0, OPSZ_4b, 0, enc, opnd);
+}
+
+static inline bool
+encode_opnd_uimm4(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
+{
+    return encode_opnd_int(10, 4, false, 0, 0, opnd, enc_out);
+}
+
 /* cmode_s_sz: Operand for 32 bit elements' shift amount */
 
 static inline bool
@@ -2726,8 +2752,8 @@ encode_opnd_wx5_imm5(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_
 {
     if (!opnd_is_reg(opnd))
         ASSERT(false);
-    uint num;
-    bool is_x;
+    uint num = 0;
+    bool is_x = false;
     if (!encode_reg(&num, &is_x, opnd_get_reg(opnd), false))
         ASSERT(false);
     *enc_out = num << 5;
@@ -3018,6 +3044,20 @@ encode_opnd_mem9off(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_o
     return encode_opnd_int(12, 9, true, 0, 0, opnd, enc_out);
 }
 
+/* imm9: 9-bit immediate operand MTE */
+
+static inline bool
+decode_opnd_imm9(uint enc, int opcode, byte *pc, OUT opnd_t *opnd)
+{
+    return decode_opnd_int(12, 9, false, 0, OPSZ_9b, 0, enc, opnd);
+}
+
+static inline bool
+encode_opnd_imm9(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
+{
+    return encode_opnd_int(12, 9, false, 0, 0, opnd, enc_out);
+}
+
 /* mem9q: memory operand with 9-bit offset; size is 16 bytes */
 
 static inline bool
@@ -3279,6 +3319,32 @@ encode_opnd_vindex_H(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_
     return true;
 }
 
+static inline bool
+decode_opnd_uimm6(uint enc, int opcode, byte *pc, OUT opnd_t *opnd)
+{
+    return decode_opnd_int(16, 6, false, 0, OPSZ_6b, 0, enc, opnd);
+}
+
+static inline bool
+encode_opnd_uimm6(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
+{
+    return encode_opnd_int(16, 6, false, 0, 0, opnd, enc_out);
+}
+
+/* simm7: 7-bit immediate operand MTE */
+
+static inline bool
+decode_opnd_simm7(uint enc, int opcode, byte *pc, OUT opnd_t *opnd)
+{
+    return decode_opnd_int(15, 7, true, 0, OPSZ_7b, 0, enc, opnd);
+}
+
+static inline bool
+encode_opnd_simm7(uint enc, int opcode, byte *pc, opnd_t opnd, OUT uint *enc_out)
+{
+    return encode_opnd_int(15, 7, true, 0, 0, opnd, enc_out);
+}
+
 /* imm12: 12-bit immediate operand of ADD/SUB */
 
 static inline bool
