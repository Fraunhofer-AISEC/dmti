diff --git a/core/ir/aarch64/instr_create_api.h b/core/ir/aarch64/instr_create_api.h
index f0a808033..0a31fd11f 100644
--- a/core/ir/aarch64/instr_create_api.h
+++ b/core/ir/aarch64/instr_create_api.h
@@ -3970,4 +3970,266 @@
  */
 #define INSTR_CREATE_psb_csync(dc) instr_create_0dst_0src(dc, OP_psb)
 
-#endif /* DR_IR_MACROS_AARCH64_H */
+/**
+ * Creates a ADDG instruction.
+ * Add immediate value to Logical Address Tag
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    ADDG <Xd|SP>, <Xn|SP>, #<uimm6>, #<uimm4>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt   The first destination register, X (Extended, 64 bits)
+ * \param Rn   The first source register, X (Extended, 64 bits)
+ * \param uimm6   Immediate Index
+ * \param uimm4   Immediate Index (Excluded Tag Mask)
+ */
+#define INSTR_CREATE_addg(dc, Rt, Rn, uimm6, uimm4) instr_create_1dst_3src(dc, OP_addg, Rt, Rn, uimm6, uimm4)
+
+/**
+ * Creates a SUBG instruction.
+ * Subtract with tag
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    SUBG <Xd|SP>, <Xn|SP>, #<uimm6>, #<uimm4>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt   The first destination register, X (Extended, 64 bits)
+ * \param Rn   The first source register, X (Extended, 64 bits)
+ * \param uimm6   Immediate Index
+ * \param uimm4   Immediate Index (Excluded Tag Mask)
+ */
+#define INSTR_CREATE_subg(dc, Rt, Rn, uimm6, uimm4) instr_create_1dst_3src(dc, OP_subg, Rt, Rn, uimm6, uimm4)
+
+
+/**
+ * Creates a IRG instruction.
+ * Random Logical Address Tag generation with exclusion
+ * 
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    IRG <Xd|SP>, <Xn|SP>, <Xm>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param Rm The second source register
+ */
+#define INSTR_CREATE_irg(dc, Rt, Rn, Rm) instr_create_1dst_2src(dc, OP_irg, Rt, Rn, Rm)
+
+/**
+ * Creates a IRG instruction with XZR.
+ * Random Logical Address Tag generation
+ * 
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    IRG <Xd|SP>, <Xn|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ */
+// #define INSTR_CREATE_wtf(dc) instr_create_0dst_0src(dc, OP_wtf)
+
+/**
+ * Creates a STGM instruction.
+ * Store a number of Allocation Tags defined in GMID_EL1, Multiple tag transfer ID register
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STGM <Xd|SP>, <Xn|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ */
+#define INSTR_CREATE_stgm(dc, Rt, Rn) instr_create_1dst_1rc(dc, OP_stgm, Rt, Rn)
+
+/**
+ * Creates a STGZM instruction.
+ * Store Tag and Zero Multiple writes a naturally aligned block of N Allocation Tags and stores zero to the associated
+data locations, where the size of N is identified in DCZID_EL0.BS.
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STGZM <Xd|SP>, <Xn|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ */
+#define INSTR_CREATE_stzgm(dc, Rt, Rn) instr_create_1dst_1rc(dc, OP_stzgm, Rt, Rn)
+
+/**
+ * Creates a LDGM instruction.
+ * Load a number of Allocation Tags defined in GMID_EL1, Multiple tag transfer ID register
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    LDGM <Xd|SP>, <Xn|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ */
+#define INSTR_CREATE_ldgm(dc, Rt, Rn) instr_create_1dst_1rc(dc, OP_ldgm, Rt, Rn)
+
+/**
+ * Creates a GMI instruction.
+ * Inserts the tag in the first source register into the excluded set specified in the second source register,
+writing the new excluded set to the destination register.
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    GMI <Xd|SP>, <Xn|SP>, <Xm>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param Rm The second source register
+ */
+#define INSTR_CREATE_gmi(dc, Rt, Rn, Rm) instr_create_1dst_2src(dc, OP_gmi, Rt, Rn, Rm)
+
+/**
+ * Creates a SUBP instruction.
+ * Subtract Pointer
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    SUBP <Xd>, <Xn|SP>, <Xm|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param Rm The second source register
+ */
+#define INSTR_CREATE_subp(dc, Rt, Rn, Rm) instr_create_1dst_2src(dc, OP_subp, Rt, Rn, Rm)
+
+/**
+ * Creates a SUBPS instruction.
+ * Subtract Pointer with sign extend
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    SUBP <Xd>, <Xn|SP>, <Xm|SP>
+ * \endverbatim
+ * \param dc   The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param Rm The second source register
+ */
+#define INSTR_CREATE_subps(dc, Rt, Rn, Rm) instr_create_1dst_2src(dc, OP_subps, Rt, Rn, Rm)
+
+/**
+ * Creates a LDG instruction.
+ * Load an Allocation Tag and merge it into destination register
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    LDG <Xd|SP>, [<Xn|SP>{, #<simm}]
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_ldg(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_ldg, Rt, Rn, imm9)
+
+/**
+ * Creates a STG instruction.
+ * Store an Allocation Tag
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STG <Xd|SP>, [<Xn|SP>{, #<simm}]
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_stg(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_stg, Rt, Rn, imm9)
+
+/**
+ * Creates a STG instruction.
+ * Store an Allocation Tag
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STG <Xd|SP>, [<Xn|SP>{, #<simm}]
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_stg_simple(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_stg, Rt, Rn, imm9)
+
+/**
+ * Creates a STZG instruction.
+ * Store an Allocation Tag zeroing the associated data location
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STZG <Xd|SP>, [<Xn|SP>], #<simm
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_stzg(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_stzg, Rt, Rn, imm9)
+
+
+/**
+ * Creates a ST2G instruction.
+ * Store an Allocation Tag to two Tag granules
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    ST2G <Xd|SP>, [<Xn|SP>{, #<simm}]
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_st2g(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_st2g, Rt, Rn, imm9)
+
+/**
+ * Creates a STZ2G instruction.
+ * Store an Allocation Tag zeroing the associated data location
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STZ2G <Xd|SP>, [<Xn|SP>], #<simm
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param imm9 The second source register
+ */
+#define INSTR_CREATE_stz2g(dc, Rt, Rn, imm9) instr_create_1dst_2src(dc, OP_stz2g, Rt, Rn, imm9)
+
+/**
+ * Creates a STGP instruction.
+ * Store an Allocation Tag and pair of registers
+ * 
+ *
+ * This macro is used to encode the forms:
+ * \verbatim
+ *    STGP <Xt1>, <Xt2>, [<Xn|SP>], #<imm>
+ * \endverbatim
+ * \param dc    The void * dcontext used to allocate memory for the #instr_t.
+ * \param Rt The first destination register
+ * \param Rn The first source register
+ * \param Rm The second source register
+ * \param simm7 The third source register
+ */
+#define INSTR_CREATE_stgp(dc, Rt, Rn, Rm, simm7) instr_create_1dst_3src(dc, OP_stgp, Rt, Rn, Rm, simm7)
+
+#endif /* DR_IR_MACROS_AARCH64_H */
\ No newline at end of file
diff --git a/core/ir/aarch64/opnd_defs.txt b/core/ir/aarch64/opnd_defs.txt
index 0688a7b86..5090c4c8c 100644
--- a/core/ir/aarch64/opnd_defs.txt
+++ b/core/ir/aarch64/opnd_defs.txt
@@ -78,6 +78,7 @@
 ---------------------------xxxxx  w0p0       # even-numbered W register (or WZR)
 ---------------------------xxxxx  w0p1       # ... add 1
 ---------------------------xxxxx  x0         # X register (or XZR)
+---------------------------xxxxx  x0sp       # X register or XSP
 ---------------------------xxxxx  memx0      # X register used as memref for SYS
 ---------------------------xxxxx  x0p0       # even-numbered X register (or XZR)
 ---------------------------xxxxx  x0p1       # ... add 1
@@ -110,6 +111,7 @@
 ------------------x-------------  cmode_h_sz # Vector shift for 16 bit elements
 ------------------xx------------  imm2idx    # imm from 13-12, used as an index
 ------------------xxxx----------  p10_low    # SVE predicate registers p0-p7
+------------------xxxx----------  uimm4      # Option for mte
 -----------------xx-------------  cmode_s_sz # Vector shift for 32 bit elements
 -----------------xx-------------  len        # imm2 len
 -----------------xxxx-----------  imm4idx    # imm4 from 11-14
@@ -152,6 +154,7 @@
 -----------xxxxx----------------  h16        # H register
 -----------xxxxx----------------  s16        # S register
 -----------xxxxxxxxx------------  mem9off    # immed offset for mem9/mem9post
+-----------xxxxxxxxx------------  imm9       # Option for mte
 -----------xxxxxxxxx--xxxxx-----  mem9q      # size is 16 bytes
 -----------xxxxxxxxx--xxxxx-----  prf9       # size is 0 bytes (prefetch variant of mem9)
 -----------xxxxxxxxx--xxxxx-----  memregq    # register offset, size is 16 bytes
@@ -162,6 +165,8 @@
 ----------?xxxxx--?-??----------  x16immvr   # computes immed from 21, 13 and 11:10
 ----------?xxxxx???-??----------  x16immvs   # computes immed from 21, 15:13 and 11:10
 ----------xx--------x-----------  vindex_H   # Index for vector with half elements (0-7)
+----------xxxxxx----------------  uimm6      # Option for mte
+----------xxxxxxx---------------  simm7      # Option for mte
 ----------xxxxxxxxxxxx----------  imm12      # immediate for ADD/SUB
 ----------xxxxxxxxxxxxxxxxx-----  mem12q     # size is 16 bytes
 ----------xxxxxxxxxxxxxxxxx-----  prf12      # size is 0 bytes (prefetch variant of mem12)
